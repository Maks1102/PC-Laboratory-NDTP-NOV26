[gd_resource type="Resource" script_class="PartInfo" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/part_info.gd" id="1"]

[resource]
script = ExtResource("1")
kind = "case"
name = "Корпус ПК"
short_name = "Корпус"
tagline = "дом для компонентов и поток воздуха"
color = "#334155"
emoji = "🗄️"
description = "Корпус — это «дом» компьютера: внутри него живут материнская плата, блок питания и накопители. Он защищает детали от пыли и случайных ударов, а главное — организует поток воздуха: вентиляторы на вдув подают холодный воздух, на выдув — выбрасывают горячий."
why = "Без корпуса детали работают «на открытом воздухе»: на них оседает пыль, их легко задеть, а горячий воздух от видеокарты не удаляется, а перемешивается с холодным. Правильный корпус снижает температуру компонентов на 10–20 °C."
fact = "Горячий воздух поднимается вверх, поэтому вытяжные вентиляторы ставят сверху и сзади, а вдувные — спереди и снизу. А боковая стенка из закалённого стекла выдерживает удар в 4–5 раз сильнее обычного оконного стекла той же толщины."
specs = [{
"label": "Форм-фактор",
"value": "ATX Mid-Tower"
}, {
"label": "Вентиляторы",
"value": "2 × 120 мм + 140 мм выдув"
}, {
"label": "Стенка",
"value": "закалённое стекло 4 мм"
}, {
"label": "Материал",
"value": "сталь 0,8 мм + пластик"
}]
one_liner = "Корпус защищает компоненты и организует сквозной поток холодного воздуха."
