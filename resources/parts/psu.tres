[ext_resource type="Script" path="res://resources/part_info.gd" id="1"]

[resource]
script = ExtResource("1")
kind = "psu"
name = "Блок питания (БП)"
short_name = "Блок питания"
tagline = "энергия для всех компонентов"
color = "#dc2626"
emoji = "🔌"
description = "Блок питания превращает 220 В из розетки в безопасные напряжения, которые нужны компонентам: 12 В, 5 В и 3,3 В. К нему подключается всё — от материнской платы до видеокарты."
why = "Каждой детали нужен «свой» ток, и все они питаются от БП. Мощному ПК нужен запас: одна видеокарта может потреблять 200–300 Вт под нагрузкой."
fact = "Сертификат 80 PLUS Gold означает, что не менее 87–90% энергии из розетки доходит до компонентов, а остальное превращается в тепло. Дешёвый БП может «съедать» до 30% энергии впустую!"
specs = [{
"label": "Мощность",
"value": "750 Вт"
}, {
"label": "Сертификат",
"value": "80 PLUS Gold"
}, {
"label": "Кабели",
"value": "модульные"
}, {
"label": "Охлаждение",
"value": "135 мм вентилятор"
}]
one_liner = "Блок питания питает все компоненты стабилизированным напряжением."
