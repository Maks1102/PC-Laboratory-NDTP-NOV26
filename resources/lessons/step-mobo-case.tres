[resource]
script = ExtResource("1")
id = "step-mobo-case"
kind = 1
part_id = "mobo"
slot_id = "slot-case"
alt_targets = PackedStringArray()
title = "Плата в корпусе"
task = "Сборка на верстаке готова! Перетащи материнскую плату в корпус — она переедет вместе с процессором, кулером, памятью и SSD, а стенд останется на верстаке."
place_task = "Тяни плату к подсвеченной зоне внутри корпуса — она развернётся вертикально и закрепится на стойках."
wrong_part = "Сейчас нужна сама материнская плата со всеми установленными на ней деталями — она подсвечена на верстаке."
wrong_slot = "Плата крепится на стойки внутри корпуса — целься в подсвеченную зону за стеклом."
extra_hint = "Плату прикручивают к латунным стойкам: между платой и металлом корпуса остаётся зазор, поэтому дорожки на обратной стороне ни к чему не прикасаются. Разъёмы I/O при этом выходят точно в вырез задней стенки."
focus = Vector3(2.0, 10.0, 14.0)
cam = Vector3(-2.0, 17.0, 38.0)
