[gd_resource type="Resource" script_class="PartInfo" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/part_info.gd" id="1"]

[resource]
script = ExtResource("1")
kind = "gpu"
name = "Видеокарта (GPU)"
short_name = "Видеокарта"
tagline = "графика и параллельные вычисления"
color = "#ea580c"
emoji = "🎮"
description = "Видеокарта — специалист по картинке. У неё свой процессор (GPU) с тысячами маленьких ядер и собственная быстрая видеопамять. Она рассчитывает каждый пиксель на экране."
why = "3D-графика — это миллионы однотипных вычислений (положение, цвет, свет каждого пикселя). Тысячи маленьких ядер GPU делают это параллельно и гораздо быстрее обычного процессора."
fact = "GPU давно считают не только графику: на них обучают нейросети, рендерят фильмы и считают научные модели. Архитектура видеокарты идеально подходит для массово-параллельных задач."
specs = [{
"label": "Видеопамять",
"value": "12 ГБ GDDR6"
}, {
"label": "Потоковые ядра",
"value": "3584"
}, {
"label": "Интерфейс",
"value": "PCIe 4.0 x16"
}, {
"label": "Потребление",
"value": "220 Вт"
}]
one_liner = "Видеокарта рисует картинку и ускоряет параллельные вычисления."
