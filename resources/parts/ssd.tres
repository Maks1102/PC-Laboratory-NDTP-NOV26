[gd_resource type="Resource" script_class="PartInfo" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/part_info.gd" id="1"]

[resource]
script = ExtResource("1")
kind = "ssd"
name = "Накопитель M.2 (SSD)"
short_name = "Накопитель"
tagline = "хранилище файлов и программ"
color = "#0d9488"
emoji = "💾"
description = "Твердотельный накопитель — это «шкаф» компьютера: здесь хранятся Windows, программы, игры и твои файлы. Формат M.2 выглядит как маленькая планка, которая втыкается прямо в плату."
why = "Данные должны где-то жить даже при выключенном питании. SSD не имеет движущихся частей и читает данные в десятки раз быстрее старых жёстких дисков (HDD)."
fact = "Разметка M.2 2280 расшифровывается просто: 22 мм — ширина, 80 мм — длина. А скорость современного NVMe-накопителя — до 7000 МБ/с: целый двухслойный DVD за полсекунды!"
specs = [{
"label": "Объём",
"value": "1 ТБ"
}, {
"label": "Интерфейс",
"value": "NVMe PCIe 4.0"
}, {
"label": "Скорость чтения",
"value": "до 7000 МБ/с"
}, {
"label": "Форм-фактор",
"value": "M.2 2280"
}]
one_liner = "SSD хранит всё: систему, программы и файлы — и делает это очень быстро."
