[gd_resource type="Resource" script_class="PartInfo" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/part_info.gd" id="1"]

[resource]
script = ExtResource("1")
kind = "ram"
name = "Оперативная память (RAM)"
short_name = "Память"
tagline = "быстрая память для текущих задач"
color = "#8b5cf6"
emoji = "⚡"
description = "Оперативная память — это «рабочий стол» компьютера. Здесь лежат данные, с которыми процессор работает прямо сейчас: открытые программы, вкладки, загруженные уровни игр."
why = "RAM в сотни раз быстрее накопителя. Когда ты запускаешь игру, её файлы поднимаются с SSD в память — иначе процессор простаивал бы в ожидании данных."
fact = "RAM энергозависима: при отключении питания она мгновенно «забывает» всё содержимое. Именно поэтому несохранённый документ пропадает, если выключить свет."
specs = [{
"label": "Тип",
"value": "DDR5"
}, {
"label": "Объём",
"value": "2 × 16 ГБ"
}, {
"label": "Частота",
"value": "6000 МТ/с"
}, {
"label": "Режим",
"value": "двухканальный (A2 + B2)"
}]
one_liner = "RAM — сверхбыстрая память для данных, над которыми работает процессор."
