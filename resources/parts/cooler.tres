[gd_resource type="Resource" script_class="PartInfo" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/part_info.gd" id="1"]

[resource]
script = ExtResource("1")
kind = "cooler"
name = "Кулер (система охлаждения)"
short_name = "Кулер"
tagline = "защита от перегрева"
color = "#64748b"
emoji = "❄️"
description = "Башенный кулер — это металлический радиатор, прижатый к крышке процессора, и вентилятор, который продувает его воздухом. Тепло от чипа уходит в радиатор и выдувается из корпуса."
why = "Под нагрузкой процессор выделяет десятки ватт тепла. Без охлаждения он за минуту разогреется до критических температур и начнёт принудительно снижать скорость — троттлинг, а может и вовсе отключиться."
fact = "Между крышкой процессора и подошвой кулера всегда наносят термоинтерфейс (термопасту). Даже две идеально гладкие поверхности на микронном уровне шершавые, и без пасты между ними остаётся воздух — лучший теплоизолятор."
specs = [{
"label": "Тип",
"value": "Башенный, 4 трубки"
}, {
"label": "Вентилятор",
"value": "120 мм"
}, {
"label": "Рассеиваемая мощность",
"value": "до 150 Вт"
}, {
"label": "Уровень шума",
"value": "22 дБА"
}]
one_liner = "Кулер отводит тепло от процессора, чтобы тот не сбрасывал скорость."
