[gd_resource type="Resource" script_class="PartInfo" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/part_info.gd" id="1"]

[resource]
script = ExtResource("1")
kind = "mobo"
name = "Материнская плата"
short_name = "Материнка"
tagline = "основание всего компьютера"
color = "#16a34a"
emoji = "🟩"
description = "Это самая большая плата компьютера — её «фундамент». На ней размещены сокет для процессора, слоты памяти, разъёмы для накопителей и видеокарты, а между ними — сотни медных дорожек, по которым бегут данные."
why = "Без материнской платы процессор не сможет «общаться» с памятью, видеокартой и накопителем: она связывает все компоненты в единую систему и раздаёт им питание."
fact = "Материнская плата — это многослойный «сэндвич»: в дорогих моделях больше 10 слоёв текстолита, и часть дорожек проходит внутри платы, как развязка на многоуровневой эстакаде."
specs = [{
"label": "Форм-фактор",
"value": "ATX, 305 × 244 мм"
}, {
"label": "Сокет",
"value": "AM5"
}, {
"label": "Чипсет",
"value": "B650"
}, {
"label": "Слоты памяти",
"value": "4 × DDR5"
}]
one_liner = "Материнская плата объединяет все детали и связывает их между собой."
