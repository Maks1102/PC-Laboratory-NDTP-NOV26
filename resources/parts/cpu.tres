[gd_resource type="Resource" script_class="PartInfo" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/part_info.gd" id="1"]

[resource]
script = ExtResource("1")
kind = "cpu"
name = "Процессор (CPU)"
short_name = "Процессор"
tagline = "мозг компьютера"
color = "#d97706"
emoji = "🧠"
description = "Центральный процессор — кремниевый чип размером с ноготь, внутри которого спрятаны миллиарды транзисторов. Он выполняет команды всех программ: от калькулятора до самой тяжёлой игры."
why = "Любое действие — открытие вкладки, физика в игре, обработка фото — это вычисления, и все они проходят через процессор. Чем он мощнее, тем быстрее компьютер думает."
fact = "Если каждый транзистор процессора был бы муравьём, их хватило бы, чтобы «заселить» сотни планет: в одном чипе транзисторов больше, чем людей на Земле, и переключаются они миллиарды раз в секунду."
specs = [{
"label": "Ядра / потоки",
"value": "8 / 16"
}, {
"label": "Частота",
"value": "до 5,7 ГГц"
}, {
"label": "Техпроцесс",
"value": "4 нм"
}, {
"label": "Сокет",
"value": "AM5"
}, {
"label": "Теплопакет (TDP)",
"value": "65 Вт"
}]
one_liner = "Процессор выполняет все вычисления — это мозг компьютера."
